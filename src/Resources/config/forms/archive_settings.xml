<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>archive_settings</key>

    <schema>
        <allOf>
            <schema>
                <anyOf>
                    <schema>
                        <properties>
                            <property name="shadowOn" value="true" />
                            <property name="shadowBaseLanguage" mandatory="true" />
                        </properties>
                    </schema>
                    <schema>
                        <properties>
                            <property name="shadowOn" value="false" />
                        </properties>
                    </schema>
                </anyOf>
            </schema>
        </allOf>
    </schema>

    <properties>
        <section name="editInfo">
            <meta>
                <title>sulu_archive.header.change_author</title>
            </meta>
            <properties>
                <property name="authored" type="datetime" colspan="6">
                    <meta>
                        <title>sulu_content.authored_date</title>
                        <info_text>sulu_archive.config.properties.info.authored_date</info_text>
                    </meta>
                </property>
                <property name="author" type="single_contact_selection" colspan="6">
                    <meta>
                        <title>sulu_content.author</title>
                        <info_text>sulu_archive.config.properties.info.author</info_text>
                    </meta>
                </property>
                <property name="showDate" type="checkbox" colspan="6">
                    <meta>
                        <title>sulu_archive.show_date</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                    </params>
                </property>
                <property name="showAuthor" type="checkbox" colspan="6">
                    <meta>
                        <title>sulu_archive.show_author</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                    </params>
                </property>
            </properties>
        </section>

        <section name="changelog">
            <meta>
                <title>sulu_archive.header.created_changed</title>
            </meta>
            <properties>
                <property name="changed" type="datetime" disabledCondition="true" colspan="6">
                    <meta>
                        <title>sulu_archive.changed_date</title>
                    </meta>
                </property>
                <property name="changerName" type="text_line" disabledCondition="true" colspan="6">
                    <meta>
                        <title>sulu_archive.changer</title>
                    </meta>
                </property>

                <property name="created" type="datetime" disabledCondition="true" colspan="6">
                    <meta>
                        <title>sulu_archive.created_date</title>
                    </meta>
                </property>
                <property name="creatorName" type="text_line" disabledCondition="true" colspan="6">
                    <meta>
                        <title>sulu_archive.creator</title>
                    </meta>
                </property>

                <property name="changelog" type="changelog_line">
                </property>

            </properties>
        </section>
    </properties>
</form>
