<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Manuxi\SuluArchiveBundle\Entity\Archive"
            table="app_archive"
            repository-class="Manuxi\SuluArchiveBundle\Repository\ArchiveRepository">

        <id name="uuid" type="string" column="uuid" length="36">
            <generator strategy="NONE"/>
        </id>

        <one-to-many field="dimensionContents"
                     target-entity="Manuxi\SuluArchiveBundle\Entity\ArchiveDimensionContent"
                     mapped-by="archive"
                     orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
