<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>archives_published</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>%sulu.model.archive.class%.dimensionContents</field-name>
            <condition>
                dimensionContent.stage = 'live' AND dimensionContent.locale = :locale AND dimensionContent.version = 0 AND dimensionContent.workflowPlace = 'published'
            </condition>
        </join>
    </joins>

    <joins name="image" ref="dimensionContent">
        <join>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
            <field-name>dimensionContent.image</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="no">
            <field-name>uuid</field-name>
            <entity-name>Manuxi\SuluArchiveBundle\Entity\Archive</entity-name>
        </property>

        <property name="version" visibility="never">
            <field-name>version</field-name>
            <entity-name>dimensionContent</entity-name>
        </property>

        <property name="image" visibility="always" translation="sulu_archive.image" sortable="false">
            <field-name>id</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
            <joins ref="image"/>
            <transformer type="thumbnails"/>
        </property>

        <property name="title" translation="sulu_admin.title" visibility="always" searchability="yes">
            <field-name>title</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="type" translation="sulu_archive.type" visibility="always">
            <field-name>type</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>
    </properties>
</list>
